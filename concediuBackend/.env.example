NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/concediu

# JWT - OBLIGATORIU: două secrete diferite, lungi și aleatorii (serverul nu pornește fără ele).
# Generează fiecare secret cu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Admin seed - contul creat de `npm run seed`. Schimbă parola după prima logare.
ADMIN_EMAIL=admin@concediu.ro
ADMIN_PASSWORD=Admin123!
